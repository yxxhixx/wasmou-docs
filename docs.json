{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Wasmou API",
  "description": "Sell digital goods through one API: catalog, instant delivery, game top-ups, per-client stock.",
  "colors": {
    "primary": "#FFC400",
    "light": "#FFD84D",
    "dark": "#0A0A0A"
  },
  "background": {
    "color": {
      "light": "#F6F5F0",
      "dark": "#0A0A0A"
    }
  },
  "fonts": {
    "family": "Inter"
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "codeblocks": "dark"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://myapp.wasmou.net"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/delivery",
              "concepts/stock",
              "concepts/pricing"
            ]
          },
          {
            "group": "Services",
            "pages": [
              "services/account",
              "services/catalog",
              "services/products",
              "services/orders",
              "services/stock",
              "services/topups",
              "services/iptv-vip"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/sync-catalog",
              "guides/automate-fulfilment",
              "guides/game-topups",
              "guides/woocommerce-plugin"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "errors",
              "changelog",
              "ai-tools"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Account",
            "openapi": "openapi.json",
            "pages": [
              "GET /account",
              "GET /balance",
              "GET /status"
            ]
          },
          {
            "group": "Catalog",
            "openapi": "openapi.json",
            "pages": [
              "GET /catalog",
              "GET /products",
              "GET /products/{productId}/variants",
              "POST /catalog/{id}/verify",
              "POST /vip-server/check"
            ]
          },
          {
            "group": "Orders",
            "openapi": "openapi.json",
            "pages": [
              "POST /products/purchase/{variantId}",
              "GET /products/order/{orderId}",
              "POST /products/orders/retrieve",
              "GET /orders"
            ]
          },
          {
            "group": "Stock",
            "openapi": "openapi.json",
            "pages": [
              "GET /stock",
              "GET /stock/{variantId}"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://myapp.wasmou.net/app",
          "icon": "gauge"
        },
        {
          "anchor": "Support",
          "href": "https://t.me/wasmou_app",
          "icon": "paper-plane"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://t.me/wasmou_app"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://myapp.wasmou.net/app"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "telegram": "https://t.me/wasmou_app"
    }
  }
}